{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "tyrsolution.app-launcher"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.elynch303.security-scan"
        },
        {
          "id": "io.github.woogy7.workspaces"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "plugin.hider",
          "hiddenEntries": []
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.krongggggg.caffeine"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "nino.tailscale"
        },
        {
          "id": "yashwanth.link"
        },
        {
          "id": "ssupt.audio-control"
        },
        {
          "id": "setup.defaults"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "im0001gt.screens"
        },
        {
          "id": "better.displays"
        },
        {
          "id": "jankeesvw.notification-center"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "ai.bkblab.displaywright"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "system"
    }
  ],
  "disabledPlugins": [
    "omarchy.audio",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "ssupt.audio-control",
    "io.github.sirjul1337.lock-explorer"
  ]
}
